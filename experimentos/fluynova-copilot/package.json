{
  "name": "@fluynova/copilot-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Laboratorio local FLUYNOVA Copilot: extracción PDF textual y OCR raster opcional, sin publicación",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.624",
    "tesseract.js": "6.0.1",
    "@napi-rs/canvas": "1.0.13"
  },
  "scripts": {
    "test:pdf": "node --test pdf-text.test.mjs",
    "test:corpus": "node corpus.test.mjs",
    "benchmark": "node BENCHMARK-CORPUS.mjs",
    "test:ocr": "node --test ocr-image.test.mjs"
  },
  "overrides": {
    "tesseract.js-core": "6.0.0"
  }
}
